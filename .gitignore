# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example은 값이 아니라 계약이다(미설정 시 무엇이 어떻게 축소되는지).
# 커밋되지 않으면 존재 이유가 없다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cluade
.omc

# AI 진단 산출물 — 스킬이 재생성하는 리포트다. 결정과 근거는 docs/decisions/에 남긴다.
.claude/ai-readability/
.claude/ai-readiness-map.html

# playwright
/test-results/
/playwright-report/
/blob-report/
