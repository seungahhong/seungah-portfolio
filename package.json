{
  "name": "seungah-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "guard": "node scripts/arch-guard.mjs && node scripts/i18n-guard.mjs",
    "prebuild": "pnpm guard",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "verify": "pnpm verify:static && pnpm verify:runtime",
    "verify:static": "pnpm lint && pnpm typecheck && node scripts/guard-selftest.mjs && pnpm build",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "vitest run && playwright test --grep-invert @nightly",
    "test:nightly": "vitest run && playwright test",
    "test:sanity:changed": "node scripts/sanity-select.mjs --vitest",
    "test:sanity:e2e": "node scripts/sanity-select.mjs --e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "groq-sdk": "^1.6.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
