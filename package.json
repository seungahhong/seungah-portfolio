{
  "name": "seungah-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "guard": "node scripts/arch-guard.mjs && node scripts/i18n-guard.mjs",
    "prebuild": "pnpm guard",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "verify": "pnpm verify:static && pnpm verify:runtime",
    "verify:static": "pnpm lint && pnpm typecheck && node scripts/guard-selftest.mjs && pnpm build",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "dayjs": "^1.11.18",
    "groq-sdk": "^1.1.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
