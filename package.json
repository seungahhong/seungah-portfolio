{
  "name": "seungah-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "guard": "node scripts/arch-guard.mjs && node scripts/i18n-guard.mjs",
    "prebuild": "pnpm guard",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "verify": "pnpm verify:static && pnpm verify:runtime",
    "verify:static": "pnpm lint && pnpm typecheck && node scripts/guard-selftest.mjs && pnpm build",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --grep @e2e-mock",
    "test:e2e:live": "E2E_MODE=live playwright test --grep @e2e-live",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "vitest run && playwright test --grep-invert @nightly",
    "test:nightly": "vitest run && playwright test",
    "test:sanity:changed": "node scripts/sanity-select.mjs --vitest",
    "test:sanity:e2e": "node scripts/sanity-select.mjs --e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "dayjs": "^1.11.18",
    "groq-sdk": "^1.1.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.3.2",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
