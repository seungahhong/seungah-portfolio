# ─────────────────────────────────────────────────────────────────────────────
# 이 파일은 "필요한 키 목록"이 아니라 계약이다.
# 값이 없으면 앱이 죽지 않고 기능만 축소된다(축소 모드).
#
#   로컬에서 아무것도 설정하지 않아도 `pnpm verify`는 전부 통과해야 한다.
#   무엇이 축소됐는지는 `pnpm preflight`가 기계 판독 가능한 형태로 알려준다.
#
# 그래서 CI에는 시크릿을 넣지 않는다 — 축소 계약 자체가 검증 대상이다(V8).
# 항목을 추가할 때는 "이 값이 없으면 무엇이 어떻게 관측되는가"를 반드시 함께 적는다.
# 목록만 있는 .env.example은 "기계 판독 불가"라는 원래 문제를 재생산한다.
# ─────────────────────────────────────────────────────────────────────────────

# AI 챗 (Groq · llama-3.3-70b-versatile)
#   미설정 → GET  /api/chat  = 200 {"available":false}  · 챗 탭이 비활성 안내를 띄운다
#            POST /api/chat  = 503
#            포트폴리오 탭·SEO·JSON-LD는 완전히 정상이다.
#   더미 값(예: verify-fake-key)을 넣으면 네트워크 호출 없이 입력 검증 분기(400)까지 열린다.
#   — isChatConfigured() 체크가 body 파싱보다 앞이라 그렇다(verify:runtime의 V9가 이 경로를 쓴다).
#   발급: https://console.groq.com/keys
GROQ_API_KEY=

# 문의 폼 메일 발송 (/api/contact · Gmail 앱 비밀번호)
#   미설정 → POST /api/contact = 503 {"ok":false,"error":"Email service not configured","fallback":true}
#            입력 검증(400)과 레이트리밋(429 · 3회/분)은 자격증명 없이도 동작한다.
#   둘 다 있어야 한다 — 하나만 있으면 미설정과 동일하게 취급된다.
GMAIL_USER=
GMAIL_PASS=

# 정규 URL (canonical·hreflang·sitemap·llms.txt의 절대 주소 기준)
#   미설정 → https://seungah-portfolio.vercel.app 사용(src/lib/seo/config.ts의 기본값)
#   프리뷰 배포처럼 도메인이 다른 환경에서만 덮어쓴다. 값이 틀리면 canonical이 엉뚱한 곳을 가리킨다.
NEXT_PUBLIC_SITE_URL=

# GA4 계측
#   미설정 → 스크립트를 아예 주입하지 않는다(검증 환경이 실집계를 오염시키지 않는다)
NEXT_PUBLIC_GA_ID=

# 검색 콘솔 소유권 확인 토큰
#   미설정 → 해당 verification 메타 태그를 렌더하지 않는다(있을 때만 조건부로 붙는다)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
